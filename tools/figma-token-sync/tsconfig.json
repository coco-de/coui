{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2020", "dom"],
    "strict": true,
    "typeRoots": ["./node_modules/@figma"],
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler"
  },
  "include": ["code.ts", "src/**/*.ts", "src/**/*.json", "scripts/**/*.ts"]
}
